# Supabase — copy this file to `.env` and fill from `supabase status`
# (local stack is remapped to 553xx ports; run `supabase start` first).
# `.env` is gitignored — never commit real values.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service-role key — ONLY used by the local integration test to bypass RLS.
# Not prefixed with VITE_ so it is never bundled into client code. Optional:
# the integration test skips its seed assertion when this is absent.
SUPABASE_SERVICE_ROLE_KEY=
